{
  "name": "dsh-hindsight",
  "version": "0.4.0",
  "description": "Official-grade DeepSeek Harness memory plugin backed by Hindsight (vectorize-io). Add /hindsight commands and model tools that recall, remember, inspect and forget through a Hindsight memory bank.",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "cordis",
    "agent-memory",
    "llm-memory",
    "long-term-memory",
    "persistent-memory",
    "vector-memory",
    "knowledge-graph",
    "hindsight",
    "vectorize",
    "memory-bank",
    "cross-session-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryu6Zero/dsh-hindsight.git"
  },
  "homepage": "https://github.com/Ryu6Zero/dsh-hindsight#readme",
  "bugs": {
    "url": "https://github.com/Ryu6Zero/dsh-hindsight/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test-client.mjs",
    "verify": "tsdown && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0"
  }
}